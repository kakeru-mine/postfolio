# In production, use a Resend-verified custom domain sender (e.g.
# "Postfolio <no-reply@postfolioapp.com>") for deliverability. The value below
# is only a local/dev placeholder.
CONTACT_FROM_EMAIL="Postfolio <onboarding@resend.dev>"
# Comma-separated emails granted admin access (e.g. announcements admin).
