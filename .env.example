STRIPE_PRO_PRICE_ID=""
STRIPE_CREATOR_PRICE_ID=""
# RevenueCat (Android in-app purchases). REVENUECAT_WEBHOOK_AUTH is the shared
# secret you set as the Authorization header on the RevenueCat webhook. The
# entitlement vars default to "pro"/"creator" if left blank.
REVENUECAT_WEBHOOK_AUTH=""
REVENUECAT_PRO_ENTITLEMENT="pro"
REVENUECAT_CREATOR_ENTITLEMENT="creator"
