# Google Cloud Console; redirect URI: <app-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: Android OAuth client id, accepted as an additional audience for the
# mobile Google sign-in ID token (/api/mobile/auth/google). Leave empty if the
# native app uses the Web client id as its serverClientId.
GOOGLE_ANDROID_CLIENT_ID=""
# Supabase Storage for re-hosting expiring Threads/Instagram CDN images.
# Create a public bucket (default name "media") and use the service role key.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="media"
